{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "july-heat-motion/**",
              "july-heat/**",
              "site/**",
              "tweaks-panel.jsx"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--aqua",
      "--aqua-deep",
      "--cream",
      "--cyan-soft",
      "--ember",
      "--ink",
      "--ink2",
      "--line",
      "--line2",
      "--magenta",
      "--magenta-br",
      "--maxw",
      "--muted",
      "--muted2",
      "--sun",
      "--sun-br"
    ],
    "tokenKinds": {
      "--ink": "color",
      "--ink2": "color",
      "--sun": "color",
      "--sun-br": "color",
      "--magenta": "color",
      "--magenta-br": "color",
      "--ember": "color",
      "--aqua": "color",
      "--aqua-deep": "color",
      "--cyan-soft": "color",
      "--cream": "color",
      "--muted": "color",
      "--muted2": "color",
      "--line": "color",
      "--line2": "color",
      "--maxw": "spacing"
    },
    "fontFamilies": []
  }
}